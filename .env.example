# ─────────────────────────────────────────────────────────────
# MediSense — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Public origin used for links in emails/notifications. No PHI in URLs, ever.
APP_NAME=MediSense

# --- Database ---
# Production: a real PostgreSQL 15+ instance (pgvector required).
# Leave DATABASE_URL empty in development to use the embedded PGlite database
# (real PostgreSQL 16 compiled to WASM, file-backed in ./.pgdata).
#
# Free hosted Postgres, no card required:
#   Supabase  Settings -> Database -> Connection string -> URI
#   Neon      Dashboard -> Connect -> pooled connection string
#
# Use the SESSION pooler (port 5432), not the transaction pooler (6543), which
# has no session and cannot run the DDL a migration needs.
#
# Two Supabase gotchas, both of which fail in confusing ways:
#   1. The direct host (db.<ref>.supabase.co) publishes an AAAA record only. It
#      is IPv6-only, so on an IPv4-only network it fails with ENOTFOUND, which
#      looks like a bad project reference rather than a missing IPv4 route. The
#      pooler host publishes A records and works either way.
#   2. The pooler requires the username to be postgres.<project-ref>. A bare
#      "postgres" is rejected as an unknown role, so the URI from the Direct tab
#      will not work against the pooler host without that suffix.
#
# Migrations also need the direct or session connection, not the 6543 pooler.
DATABASE_URL=
# PGlite data directory (development only)
PGLITE_DATA_DIR=./.pgdata
# Path to the SQL migration folder
MIGRATIONS_DIR=./src/database/migrations

# --- Server-side HMAC key ---
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# There is no login, so this is not a session secret. It keys the rate-limit
# buckets and the IP / user-agent hashes in the audit log, and is the fallback
# encryption key for report text when DATA_ENCRYPTION_KEY is unset.
AUTH_SECRET=
# Argon2id parameters (memory in KiB, iterations, parallelism). Only read by the
# password hasher, which no part of the app uses any more.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# --- Security ---
# Comma-separated list of allowed origins for CORS / CSRF origin checks
ALLOWED_ORIGINS=http://localhost:3000
# Max upload size in bytes (default 10 MiB)
MAX_UPLOAD_BYTES=10485760
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Encryption at rest ---
# 32-byte key, base64url. Used for encrypting sensitive report payloads before
# they are written to the database. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=

# --- Object storage ---
# Set S3_BUCKET to move uploads off the local filesystem. Everything here speaks
# the S3 API, so the same settings work for every provider below and moving
# between them needs no code change.
#
# Supabase (free, no card):
#   Storage -> New bucket. Then Project Settings -> API Keys -> S3 keys -> New
#   access key. S3_REGION is your project's region, e.g. "ap-south-1".
#   Set S3_FORCE_PATH_STYLE=true.
#
# Cloudflare R2:  endpoint https://<account>.r2.cloudflarestorage.com
# Backblaze B2:   endpoint https://s3.<region>.backblazeb2.com
# AWS S3:         leave S3_ENDPOINT empty, and S3_FORCE_PATH_STYLE=false
#
# The bucket must be PRIVATE with public access blocked. Nothing in this app
# generates a public URL for an upload, and a public bucket would make every
# stored report world-readable.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Local uploads, used only when S3_BUCKET is empty. Note that a serverless host
# has a read-only or ephemeral filesystem, so this cannot be used in production.
STORAGE_LOCAL_DIR=./.uploads

# --- AI providers ---
# LLM: mock | openai | anthropic | ollama
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TEMPERATURE=0.2

# Embeddings: mock | openai | ollama
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=384

# OCR: mock | tesseract | openai-vision | google-vision
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_LANGUAGES=eng
OCR_MAX_PAGES=10

# --- Feature flags ---
# Keep the deterministic safety layer on. Do not disable in production.
SAFETY_ENGINE_ENABLED=true
CLINICAL_RULES_MODE=enforce

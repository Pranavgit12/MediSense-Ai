{
  "name": "medisense",
  "version": "0.1.0",
  "private": true,
  "description": "MediSense - AI health assistant that explains medical reports and helps you prepare for a doctor.",
  "type": "module",
  "engines": {
    "node": ">=20.11 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:configure": "tsx scripts/set-database-url.ts",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/db-check.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/reset.ts",
    "db:verify": "tsx scripts/verify-sources.ts",
    "db:verify-schema": "tsx scripts/verify-schema.ts",
    "data:build": "tsx scripts/build-datasets.ts",
    "data:harvest": "tsx scripts/harvest-corpus.ts",
    "data:verify": "tsx scripts/verify-datasets.ts",
    "data:verify-symptoms": "tsx scripts/verify-symptom-catalog.ts",
    "data:check-citations": "tsx scripts/verify-sources.ts",
    "data:refresh": "npm run data:build && npm run data:harvest && npm run data:check-citations",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@electric-sql/pglite": "^0.2.17",
    "@node-rs/argon2": "^2.0.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.6",
    "kysely": "^0.29.6",
    "lucide-react": "^1.48.0",
    "next": "^15.1.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^6.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true
  }
}
